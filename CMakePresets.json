{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-x64",
      "hidden": true,
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "msvc-x86",
      "hidden": true,
      "inherits": "windows-base",
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "clang-cl-x64",
      "hidden": true,
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl" }
    },
    { "name": "msvc-x64-debug", "displayName": "MSVC x64 Debug", "inherits": "msvc-x64", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "msvc-x64-release", "displayName": "MSVC x64 Release", "inherits": "msvc-x64", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "msvc-x86-debug", "displayName": "MSVC x86 Debug", "inherits": "msvc-x86", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "msvc-x86-release", "displayName": "MSVC x86 Release", "inherits": "msvc-x86", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "clang-cl-x64-debug", "displayName": "clang-cl x64 Debug", "inherits": "clang-cl-x64", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    {
      "name": "clang-cl-x64-asan",
      "displayName": "clang-cl x64 Debug + AddressSanitizer",
      "description": "clang-cl's ASan runtime does not support the debug CRT, so the release DLL CRT is used.",
      "inherits": "clang-cl-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "UNREALLIB_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "clang-cl-x64-fuzz",
      "displayName": "clang-cl x64 libFuzzer + AddressSanitizer (fuzzers only)",
      "description": "Builds tests/Fuzz as libFuzzer executables: static release CRT (libFuzzer's runtime is /MT), unoptimized (optimized code under ASan + libFuzzer crashes while throwing C++ exceptions with clang-cl 22; see docs/development.md). Tests, tools and examples are off.",
      "inherits": "clang-cl-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "UNREALLIB_ENABLE_ASAN": "ON",
        "UNREALLIB_BUILD_FUZZERS": "ON",
        "UNREALLIB_BUILD_TESTS": "OFF",
        "UNREALLIB_BUILD_TOOLS": "OFF",
        "UNREALLIB_BUILD_EXAMPLES": "OFF",
        "UNREALLIB_INSTALL": "OFF"
      }
    },
    {
      "name": "msvc-x64-asan",
      "displayName": "MSVC x64 Debug + AddressSanitizer (needs the VS 'C++ AddressSanitizer' component)",
      "inherits": "msvc-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "UNREALLIB_ENABLE_ASAN": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-x64-debug", "configurePreset": "msvc-x64-debug" },
    { "name": "msvc-x64-release", "configurePreset": "msvc-x64-release" },
    { "name": "msvc-x86-debug", "configurePreset": "msvc-x86-debug" },
    { "name": "msvc-x86-release", "configurePreset": "msvc-x86-release" },
    { "name": "clang-cl-x64-debug", "configurePreset": "clang-cl-x64-debug" },
    { "name": "clang-cl-x64-asan", "configurePreset": "clang-cl-x64-asan" },
    { "name": "clang-cl-x64-fuzz", "configurePreset": "clang-cl-x64-fuzz" },
    { "name": "msvc-x64-asan", "configurePreset": "msvc-x64-asan" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "msvc-x64-debug", "inherits": "base", "configurePreset": "msvc-x64-debug" },
    { "name": "msvc-x64-release", "inherits": "base", "configurePreset": "msvc-x64-release" },
    { "name": "msvc-x86-debug", "inherits": "base", "configurePreset": "msvc-x86-debug" },
    { "name": "msvc-x86-release", "inherits": "base", "configurePreset": "msvc-x86-release" },
    { "name": "clang-cl-x64-debug", "inherits": "base", "configurePreset": "clang-cl-x64-debug" },
    { "name": "clang-cl-x64-asan", "inherits": "base", "configurePreset": "clang-cl-x64-asan" },
    { "name": "msvc-x64-asan", "inherits": "base", "configurePreset": "msvc-x64-asan" }
  ]
}
