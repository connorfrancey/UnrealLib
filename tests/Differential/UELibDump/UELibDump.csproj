<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reference dumper for differential testing: loads packages with upstream UELib (Eliot.UELib) and writes the
    "raw" JSON schema compared by tests/Differential/DifferentialTests.cpp.

    UELibSourceDir must point at an Unreal-Library checkout (CMake passes the CPM-fetched, pinned source).
    Build:  dotnet build UELibDump.csproj -c Release -p:UELibSourceDir=<dir> artifacts-path=<build dir>
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UELibDump</AssemblyName>
    <RootNamespace>UnrealLib.Differential</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(UELibSourceDir)/src/Eliot.UELib.csproj" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>

  <Target Name="CheckUELibSourceDir" BeforeTargets="Restore;Build">
    <Error Condition="'$(UELibSourceDir)' == '' Or !Exists('$(UELibSourceDir)/src/Eliot.UELib.csproj')"
           Text="Set UELibSourceDir to an EliotVU/Unreal-Library checkout (got '$(UELibSourceDir)')." />
  </Target>

</Project>
