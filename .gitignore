*.u
*.upk
*.umap
*.me1
*.ut3
*.udk
*.xxx
tests/Fixtures/**/*
!tests/Fixtures/README.md

# Misc
CMakeUserPresets.json
compile_commands.json
*.log

# Local settings of scripts/manage.py
.manage.json
__pycache__/
.idea/discord.xml
