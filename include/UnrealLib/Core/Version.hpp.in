#pragma once

/// @file
/// @brief UnrealLib library version (generated by CMake from Version.hpp.in).

#include <string_view>

namespace UnrealLib
{
    /// @brief Library version components.
    struct LibraryVersion
    {
        int major; ///< Major version.
        int minor; ///< Minor version.
        int patch; ///< Patch version.
    };

    /// @brief The version of UnrealLib this header belongs to.
    inline constexpr LibraryVersion library_version{@PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@};

    /// @brief The version of UnrealLib as a "major.minor.patch" string.
    inline constexpr std::string_view library_version_string{"@PROJECT_VERSION@"};
}
